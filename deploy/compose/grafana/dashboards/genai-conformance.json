{
  "uid": "genai-conformance",
  "title": "GenAI Conformance Gateway",
  "description": "Self-observability of the conformance gateway: how trustworthy is the GenAI telemetry flowing through it, and how is the gateway itself doing.",
  "tags": ["genai", "opentelemetry", "conformance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Worst service score",
      "description": "Lowest conformance score across services. Below 100% some service emits GenAI telemetry that violates the conventions.",
      "gridPos": {"h": 7, "w": 5, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "min(genai_conformance_score)", "legendFormat": "score", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "#d03b3b", "value": null},
              {"color": "#fab219", "value": 0.8},
              {"color": "#0ca30c", "value": 0.95}
            ]
          }
        },
        "overrides": []
      },
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Conformance score by service",
      "gridPos": {"h": 7, "w": 10, "x": 5, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "genai_conformance_score", "legendFormat": "{{service}}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {"lineWidth": 2, "fillOpacity": 0, "pointSize": 4, "spanNulls": true}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Findings by severity",
      "description": "Rate of conformance findings. ERROR breaks standards-based consumers; WARNING degrades them; INFO is advisory.",
      "gridPos": {"h": 7, "w": 9, "x": 15, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (severity) (rate(genai_conformance_findings_total[1m])) * 60", "legendFormat": "{{severity}}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 12, "pointSize": 4}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "ERROR"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#d03b3b"}}]},
          {"matcher": {"id": "byName", "options": "WARNING"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#fab219"}}]},
          {"matcher": {"id": "byName", "options": "INFO"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#3987e5"}}]}
        ]
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Findings by rule (last hour)",
      "gridPos": {"h": 8, "w": 9, "x": 0, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "topk(10, sum by (rule_id) (increase(genai_conformance_findings_total[1h])))", "legendFormat": "{{rule_id}}", "refId": "A", "instant": true}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {"mode": "fixed", "fixedColor": "#3987e5"}
        },
        "overrides": []
      },
      "options": {"displayMode": "basic", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Telemetry ingested",
      "gridPos": {"h": 8, "w": 8, "x": 9, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(genai_conformance_spans_received_total[1m]) * 60", "legendFormat": "spans", "refId": "A"},
        {"expr": "rate(genai_conformance_metric_points_received_total[1m]) * 60", "legendFormat": "metric points", "refId": "B"},
        {"expr": "rate(genai_conformance_log_records_received_total[1m]) * 60", "legendFormat": "log records", "refId": "C"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 0, "pointSize": 4}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Trace windows",
      "description": "Bounded assembly at work: open windows, and closes by reason. Evictions or late spans mean the bounds or upstream batching need tuning.",
      "gridPos": {"h": 8, "w": 7, "x": 17, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "genai_conformance_traces_open", "legendFormat": "open", "refId": "A"},
        {"expr": "sum by (reason) (rate(genai_conformance_windows_closed_total[1m])) * 60", "legendFormat": "closed: {{reason}}", "refId": "B"},
        {"expr": "rate(genai_conformance_late_spans_total[1m]) * 60", "legendFormat": "late spans", "refId": "C"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 0, "pointSize": 4}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "late spans"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#fab219"}}]}
        ]
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Checks evaluated by service",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (service) (rate(genai_conformance_checks_total[1m])) * 60", "legendFormat": "{{service}}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 0, "pointSize": 4}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Gateway build",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "genai_conformance_build_info", "legendFormat": "v{{version}} · semconv {{semconv_sha}}", "refId": "A", "instant": true}
      ],
      "fieldConfig": {
        "defaults": {"unit": "none", "color": {"mode": "fixed", "fixedColor": "#898781"}},
        "overrides": []
      },
      "options": {"colorMode": "none", "graphMode": "none", "textMode": "name", "reduceOptions": {"calcs": ["lastNotNull"]}}
    }
  ]
}
